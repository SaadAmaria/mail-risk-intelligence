# Copy to .env and fill in. Never commit .env.
# Leave LLM_* unset to run without an LLM (recorded fixtures / degraded mode only).

PORT=3001
# Interface the API binds to. Loopback by default; set 0.0.0.0 only deliberately.
HOST=127.0.0.1
# Relative to the server workspace directory (server/).
DB_PATH=./data/mail-risk.db
# Optional. Defaults to mock_mailbox_data.json in the repository root (read-only).
# SEED_PATH=

# OpenAI-compatible Chat Completions endpoint (one provider, no automatic fallback chain).
# Examples (verify current URLs/models/limits before use):
#   Groq (free tier, needs a key):  https://api.groq.com/openai/v1   model: openai/gpt-oss-120b
#   Ollama (local, no key):         http://localhost:11434/v1
# With no endpoint/model (or no key for a hosted endpoint) the app runs in degraded mode:
# emails get a code-only extraction and are marked "degraded", never "safe".
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# low | medium | high | none (none omits the parameter, e.g. for models that do not support it)
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_MS=25000
# Transient failures (timeout, network, 429, 5xx) are retried this many times with backoff.
LLM_MAX_RETRIES=2
# Upper bound per call. Reasoning models spend part of it on reasoning tokens.
LLM_MAX_COMPLETION_TOKENS=3000

# The organization's own domains (comma separated). Used as the reference for look-alike
# sender/link detection; mail from these domains is never treated as a look-alike.
ORG_DOMAINS=arcline.com

# Analysis queue. Start-up never sends mailbox content to a provider unless this is "true".
ANALYSIS_AUTOSTART=false
ANALYSIS_CONCURRENCY=1
# An email is not retried automatically more than this many runs.
ANALYSIS_MAX_RUNS=3
ANALYSIS_QUEUE_CAPACITY=200
