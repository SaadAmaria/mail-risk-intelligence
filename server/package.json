{
  "name": "@mri/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "record": "tsx --env-file-if-exists=../.env src/replay/recordCli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@mri/shared": "*",
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "postal-mime": "^4.0.5",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "vitest": "^5.0.3"
  }
}
